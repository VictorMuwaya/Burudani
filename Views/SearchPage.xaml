<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Burudani.ViewModels"
             xmlns:models="clr-namespace:Burudani.Models"
             xmlns:controls="clr-namespace:Burudani.Controls"
             xmlns:helpers="clr-namespace:Burudani.Helpers"
             x:Class="Burudani.Views.SearchPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource AppBackgroundLight}, Dark={StaticResource AppBackgroundDark}}">

    <ContentView.BindingContext>
        <vm:SearchViewModel x:Name="ViewModel" />
    </ContentView.BindingContext>

    <Grid RowDefinitions="Auto, *">
        <!-- ── Search & Filter Header Panel ── -->
        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                StrokeThickness="1"
                Padding="16,10">
            <VerticalStackLayout Spacing="8">
                <!-- Top Row: Search Input + Buttons -->
                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="8">
                    <Border Grid.Column="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                            StrokeThickness="1"
                            Padding="10,0"
                            HeightRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto, *">
                            <Label Text="{x:Static helpers:MaterialIcon.Magnify}"
                                   FontFamily="MaterialIcons"
                                   TextColor="#ea580c"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0" />
                            <Entry Grid.Column="1"
                                   x:Name="SearchEntry"
                                   Text="{Binding SearchQuery}"
                                   Placeholder="Search songs, artists, albums, or paste YouTube URLs..."
                                   PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   FontSize="13"
                                  
                                   ClearButtonVisibility="WhileEditing"
                                   Completed="OnSearchCompleted"
                                   TextChanged="OnSearchTextChanged" />
                        </Grid>
                    </Border>

                    <Button Grid.Column="1"
                            Text="Search"
                            Command="{Binding SearchCommand}"
                            BackgroundColor="#ea580c"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="12"
                            HeightRequest="40"
                            Padding="18,0"
                            CornerRadius="8" />

                    <Button Grid.Column="2"
                            Text="Clear"
                            Command="{Binding ClearSearchCommand}"
                            BackgroundColor="{AppThemeBinding Light=#e2e8f0, Dark=#24242a}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=#cbd5e1}"
                            BorderColor="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark=#3f3f46}"
                            BorderWidth="1"
                            FontSize="12"
                            HeightRequest="40"
                            Padding="14,0"
                            CornerRadius="8" />
                </Grid>

                <!-- Autocomplete Dropdown Suggestions -->
                <CollectionView ItemsSource="{Binding Suggestions}"
                                MaximumHeightRequest="150"
                                IsVisible="{Binding HasSuggestions}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#18181d}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark=#27272a}"
                                    Padding="12,8">
                                <Label Text="{Binding .}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=#e2e8f0}"
                                       FontSize="13" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSuggestionTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Filter & View Mode Controls Bar -->
                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                        <!-- Dropdown 1: Content Type (Songs / Albums) -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                StrokeThickness="1"
                                HeightRequest="34"
                                Padding="10,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIcon.Music}"
                                       FontFamily="MaterialIcons"
                                       TextColor="#ea580c"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding SelectedContentType}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Text="▾"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseContentTypeCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Dropdown 2: Layout View (Grid View / List View) -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                StrokeThickness="1"
                                HeightRequest="34"
                                Padding="10,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIcon.ViewGrid}"
                                       FontFamily="MaterialIcons"
                                       TextColor="#ea580c"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding SelectedLayoutView}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Text="▾"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseLayoutViewCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Dropdown 1: Catalog Source -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                StrokeThickness="1"
                                HeightRequest="34"
                                Padding="10,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIcon.Web}"
                                       FontFamily="MaterialIcons"
                                       TextColor="#ea580c"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding CurrentSource.Value}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Text="▾"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseSourceCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Dropdown 2: Region -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource InputBackgroundLight}, Dark={StaticResource InputBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                StrokeThickness="1"
                                HeightRequest="34"
                                Padding="10,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="{x:Static helpers:MaterialIcon.Earth}"
                                       FontFamily="MaterialIcons"
                                       TextColor="#ea580c"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding CurrentRegion.Value}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                <Label Text="▾"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                       FontSize="10"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ChooseRegionCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <!-- ── Main Content Area ── -->
        <Grid Grid.Row="1">
            <!-- 1. Offline State (Standard No Internet Connection Icon in Center) -->
            <VerticalStackLayout IsVisible="{Binding IsOffline}"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="14"
                                 Margin="20">
                <Label Text="{x:Static helpers:MaterialIcon.WifiOff}"
                       FontFamily="MaterialIcons"
                       FontSize="48"
                       TextColor="{AppThemeBinding Light=#94a3b8, Dark=#71717a}"
                       HorizontalOptions="Center" />
                <Label Text="No Internet Connection"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       FontSize="18"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Unable to load search results. Please check your network connection and try again."
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       FontSize="12"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center" />
                <!-- Refresh Button for Windows -->
                <Button Text="Refresh"
                        IsVisible="{OnPlatform WinUI=True, Default=False}"
                        Command="{Binding RefreshCommand}"
                        BackgroundColor="#ea580c"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="36"
                        Padding="24,0"
                        HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- 2. Transparent Lottie Activity Loader -->
            <controls:LottieLoaderView IsVisible="{Binding IsLoading}"
                                       StatusMessage="{Binding StatusMessage}" />

            <!-- 3. Empty / Initial State (Before search) -->
            <VerticalStackLayout HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12"
                                 Padding="24"
                                 IsVisible="{Binding HasSearched, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{x:Static helpers:MaterialIcon.Magnify}"
                       FontFamily="MaterialIcons"
                       FontSize="56"
                       TextColor="{AppThemeBinding Light=#94a3b8, Dark=#52525b}"
                       HorizontalOptions="Center" />
                <Label Text="Search Music Worldwide"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />
                <Label Text="Type a song title, artist, or paste a link above to search."
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       FontSize="12"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- 4. Results Container (with Android Pull-to-Refresh & Windows Refresh) -->
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         IsVisible="{Binding IsContentVisible}">
            <Grid>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- A. GRID VIEW (Tracks Grid with Artwork + Buttons)  -->
                <!-- ═══════════════════════════════════════════════════ -->
                <CollectionView ItemsSource="{Binding Tracks}"
                                ItemSizingStrategy="MeasureFirstItem"
                                IsVisible="{Binding IsSongsGridView}"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreTracksCommand}"
                                Margin="16,8">
                    <CollectionView.Header>
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="0,0,0,10" />
                    </CollectionView.Header>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="{OnPlatform WinUI=4, Default=2}"
                                         HorizontalItemSpacing="12"
                                         VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackItem">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                    StrokeThickness="1"
                                    Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <!-- Artwork Container with Centered Translucent Play & Top-Right Download -->
                                    <Grid HeightRequest="136">
                                        <controls:ArtworkView HeightRequest="136"
                                                              ArtworkUrl="{Binding ThumbnailUrl}"
                                                              CacheKey="{Binding Id}"
                                                              CornerRadiusValue="8" />

                                        <!-- Centered Play Button -->
                                        <Border BackgroundColor="#8018181b"
                                                Stroke="#40ffffff"
                                                StrokeThickness="1"
                                                WidthRequest="46"
                                                HeightRequest="46"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="23" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=PlayTrackCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{x:Static helpers:MaterialIcon.Play}"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="22"
                                                   TextColor="#ea580c"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Top-Right Accent Download Button -->
                                        <Border BackgroundColor="#c8ea580c"
                                                StrokeThickness="0"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=QueueTrackCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{x:Static helpers:MaterialIcon.Download}"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="15"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Duration Badge -->
                                        <Border HorizontalOptions="End"
                                                VerticalOptions="End"
                                                Margin="6"
                                                BackgroundColor="#b3000000"
                                                Padding="6,2"
                                                StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4" />
                                            </Border.StrokeShape>
                                            <Label Text="{Binding DurationStr}"
                                                   TextColor="White"
                                                   FontSize="10"
                                                   FontAttributes="Bold" />
                                        </Border>
                                    </Grid>

                                    <!-- Song Title & Artist Cleanly Below Artwork -->
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />

                                        <Label Text="{Binding Artist}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               FontSize="11"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- B. ALBUMS VIEW                                     -->
                <!-- ═══════════════════════════════════════════════════ -->
                <CollectionView ItemsSource="{Binding Albums}"
                                ItemSizingStrategy="MeasureFirstItem"
                                IsVisible="{Binding IsAlbumsView}"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreAlbumsCommand}"
                                Margin="16,8">
                    <CollectionView.Header>
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="0,0,0,10" />
                    </CollectionView.Header>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="{OnPlatform WinUI=4, Default=2}"
                                         HorizontalItemSpacing="12"
                                         VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AlbumItem">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                    StrokeThickness="1"
                                    Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="8">
                                    <Grid HeightRequest="136">
                                        <controls:ArtworkView HeightRequest="136"
                                                              ArtworkUrl="{Binding ArtworkUrl}"
                                                              CacheKey="{Binding AlbumId}"
                                                              CornerRadiusValue="8" />

                                        <Border BackgroundColor="#c8ea580c"
                                                StrokeThickness="0"
                                                WidthRequest="32"
                                                HeightRequest="32"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=QueueAlbumCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{x:Static helpers:MaterialIcon.Download}"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="15"
                                                   TextColor="White"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation" />

                                        <Label Text="{Binding Artist}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               FontSize="11"
                                               LineBreakMode="TailTruncation" />

                                        <Label Text="{Binding SubTitle}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                               FontSize="10" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- C. TRACKS (LIST) VIEW                              -->
                <!-- ═══════════════════════════════════════════════════ -->
                <CollectionView ItemsSource="{Binding Tracks}"
                                ItemSizingStrategy="MeasureFirstItem"
                                IsVisible="{Binding IsSongsListView}"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreTracksCommand}"
                                Margin="16,8">
                    <CollectionView.Header>
                        <Label Text="{Binding StatusMessage}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="12"
                               FontAttributes="Bold"
                               Margin="0,0,0,8" />
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TrackItem">
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackgroundLight}, Dark={StaticResource CardBackgroundDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
                                    StrokeThickness="1"
                                    Padding="10,8"
                                    Margin="0,2">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="48, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <Grid Grid.Column="0" WidthRequest="44" HeightRequest="44">
                                        <controls:ArtworkView WidthRequest="44"
                                                              HeightRequest="44"
                                                              ArtworkUrl="{Binding ThumbnailUrl}"
                                                              CacheKey="{Binding Id}"
                                                              CornerRadiusValue="6" />
                                        <Border BackgroundColor="#8018181b"
                                                StrokeThickness="0"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="14" />
                                            </Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=PlayTrackCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{x:Static helpers:MaterialIcon.Play}"
                                                   FontFamily="MaterialIcons"
                                                   FontSize="15"
                                                   TextColor="#ea580c"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                               FontAttributes="Bold"
                                               FontSize="13"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding Artist}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                   FontSize="11"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="•"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                   FontSize="11" />
                                            <Label Text="{Binding DurationStr}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                   FontSize="11" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <!-- Download / Queue Button -->
                                    <Border Grid.Column="2"
                                            BackgroundColor="#ea580c"
                                            StrokeThickness="0"
                                            WidthRequest="34"
                                            HeightRequest="34"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="17" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SearchViewModel}}, Path=QueueTrackCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{x:Static helpers:MaterialIcon.Download}"
                                               FontFamily="MaterialIcons"
                                               FontSize="16"
                                               TextColor="White"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            </RefreshView>
        </Grid>
    </Grid>
</ContentView>
