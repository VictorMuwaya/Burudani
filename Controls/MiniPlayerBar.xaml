<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Burudani.Controls"
             xmlns:helpers="clr-namespace:Burudani.Helpers"
             x:Class="Burudani.Controls.MiniPlayerBar">
    <Border BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceBackgroundLight}, Dark={StaticResource SurfaceBackgroundDark}}"
            Stroke="{AppThemeBinding Light={StaticResource CardBorderLight}, Dark={StaticResource CardBorderDark}}"
            StrokeThickness="1"
            Padding="{OnPlatform WinUI='14,8', Default='10,8'}"
            IsVisible="{Binding CurrentTrack, Converter={StaticResource NullOrEmptyToBoolConverter}}">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{OnPlatform WinUI=12, Default=16}" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="Black"
                    Opacity="0.3"
                    Radius="12"
                    Offset="0,3" />
        </Border.Shadow>

        <Grid>
            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 1. DESKTOP LAYOUT (Windows WinUI: Single Horizontal Row)   -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <Grid IsVisible="{OnPlatform WinUI=True, Default=False}"
                  ColumnDefinitions="Auto, *, Auto, Auto, Auto"
                  ColumnSpacing="12"
                  VerticalOptions="Center">
                
                <!-- Left: Cover Art + Track Info (Click to open full player) -->
                <Grid Grid.Column="0"
                      ColumnDefinitions="40, Auto"
                      ColumnSpacing="10"
                      ToolTipProperties.Text="Open Full Player"
                      VerticalOptions="Center">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavigateToPlayerTapped" />
                    </Grid.GestureRecognizers>
                    <controls:ArtworkView Grid.Column="0"
                                          WidthRequest="40"
                                          HeightRequest="40"
                                          ArtworkUrl="{Binding CurrentTrack.ThumbnailUrl}"
                                          CacheKey="{Binding CurrentTrack.Id}"
                                          CornerRadiusValue="6" />

                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="1"
                                         MaximumWidthRequest="220">
                        <Label Text="{Binding CurrentTrack.Title, FallbackValue='No track'}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               FontAttributes="Bold"
                               FontSize="12"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown'}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="11"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Center: Transport Controls + Timestamps + Seek Slider -->
                <Grid Grid.Column="1"
                      ColumnDefinitions="Auto, Auto, Auto, Auto, Auto, *"
                      ColumnSpacing="8"
                      VerticalOptions="Center">
                    
                    <!-- Prev Button -->
                    <Button Grid.Column="0"
                            Text="{x:Static helpers:MaterialIcon.SkipPrevious}"
                            FontFamily="MaterialIcons"
                            FontSize="18"
                            ToolTipProperties.Text="Previous Track"
                            Clicked="OnPrevClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=#cbd5e1}"
                            WidthRequest="32"
                            HeightRequest="32"
                            CornerRadius="16"
                            Padding="0" />

                    <!-- Play / Pause Button -->
                    <Button Grid.Column="1"
                            Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                            FontFamily="MaterialIcons"
                            FontSize="18"
                            ToolTipProperties.Text="Play / Pause"
                            Clicked="OnPlayPauseClicked"
                            BackgroundColor="#ea580c"
                            TextColor="White"
                            WidthRequest="34"
                            HeightRequest="34"
                            CornerRadius="17"
                            Padding="0" />

                    <!-- Next Button -->
                    <Button Grid.Column="2"
                            Text="{x:Static helpers:MaterialIcon.SkipNext}"
                            FontFamily="MaterialIcons"
                            FontSize="18"
                            ToolTipProperties.Text="Next Track"
                            Clicked="OnNextClicked"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark=#cbd5e1}"
                            WidthRequest="32"
                            HeightRequest="32"
                            CornerRadius="16"
                            Padding="0" />

                    <!-- Loop (Repeat) Button -->
                    <Button Grid.Column="3"
                            Text="{Binding Repeat, Converter={StaticResource RepeatModeIconConverter}}"
                            FontFamily="MaterialIcons"
                            FontSize="16"
                            ToolTipProperties.Text="Toggle Repeat"
                            Clicked="OnLoopClicked"
                            BackgroundColor="Transparent"
                            TextColor="{Binding Repeat, Converter={StaticResource RepeatModeColorConverter}}"
                            WidthRequest="32"
                            HeightRequest="32"
                            CornerRadius="16"
                            Padding="0" />

                    <!-- Time string -->
                    <Label Grid.Column="4"
                           x:Name="WindowsTimeStringLabel"
                           Text="{Binding TimeString, FallbackValue='0:00 / 0:00'}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="10"
                           VerticalOptions="Center"
                           Margin="4,0" />

                    <!-- Seek Slider Container with Tap-To-Seek and Drag (Windows Desktop) -->
                    <Grid Grid.Column="5"
                          x:Name="WindowsSeekContainer"
                          VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnWindowsSeekTrackTapped" />
                        </Grid.GestureRecognizers>
                        <Slider x:Name="WindowsSeekSlider"
                                Minimum="0"
                                Maximum="{Binding DurationSeconds, FallbackValue=100}"
                                MinimumTrackColor="#ea580c"
                                MaximumTrackColor="{AppThemeBinding Light=#cbd5e1, Dark=#27272a}"
                                ThumbColor="#ea580c"
                                VerticalOptions="Center"
                                DragStarted="OnSeekDragStarted"
                                DragCompleted="OnSeekCompleted"
                                ValueChanged="OnSeekValueChanged" />
                    </Grid>
                </Grid>

                <!-- Volume Icon (Click to toggle mute) -->
                <Label Grid.Column="2"
                       Text="{Binding IsMuted, Converter={StaticResource VolumeIconConverter}}"
                       FontFamily="MaterialIcons"
                       FontSize="16"
                       ToolTipProperties.Text="Toggle Mute"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnVolumeIconTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Volume Slider -->
                <Slider Grid.Column="3"
                        Minimum="0"
                        Maximum="1"
                        ToolTipProperties.Text="Volume"
                        Value="{Binding Volume, Mode=TwoWay}"
                        WidthRequest="80"
                        MinimumTrackColor="#ea580c"
                        MaximumTrackColor="{AppThemeBinding Light=#cbd5e1, Dark=#27272a}"
                        ThumbColor="#ea580c"
                        VerticalOptions="Center" />

                <!-- Close Mini Player Button -->
                <Button Grid.Column="4"
                        Text="{x:Static helpers:MaterialIcon.Close}"
                        FontFamily="MaterialIcons"
                        FontSize="16"
                        ToolTipProperties.Text="Close Mini Player"
                        Clicked="OnCloseClicked"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                        WidthRequest="28"
                        HeightRequest="28"
                        CornerRadius="14"
                        Padding="0" />
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════ -->
            <!-- 2. MOBILE LAYOUT (Android: Gestures + Seek Below)          -->
            <!-- ═══════════════════════════════════════════════════════════ -->
            <VerticalStackLayout IsVisible="{OnPlatform WinUI=False, Default=True}"
                                 Spacing="4">
                <VerticalStackLayout.GestureRecognizers>
                    <SwipeGestureRecognizer Direction="Left" Swiped="OnSwipeLeft" />
                    <SwipeGestureRecognizer Direction="Right" Swiped="OnSwipeRight" />
                </VerticalStackLayout.GestureRecognizers>
                
                <!-- Row 0: Artwork + Track Info on Left, Play/Pause on Far Right -->
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="10"
                      VerticalOptions="Center">
                    
                    <!-- Cover Art Thumbnail -->
                    <controls:ArtworkView Grid.Column="0"
                                          WidthRequest="38"
                                          HeightRequest="38"
                                          ArtworkUrl="{Binding CurrentTrack.ThumbnailUrl}"
                                          CacheKey="{Binding CurrentTrack.Id}"
                                          CornerRadiusValue="6"
                                          VerticalOptions="Center">
                        <controls:ArtworkView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToPlayerTapped" />
                        </controls:ArtworkView.GestureRecognizers>
                    </controls:ArtworkView>

                    <!-- Title & Artist Info -->
                    <VerticalStackLayout Grid.Column="1"
                                         VerticalOptions="Center"
                                         Spacing="1">
                        <VerticalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNavigateToPlayerTapped" />
                        </VerticalStackLayout.GestureRecognizers>
                        <Label Text="{Binding CurrentTrack.Title, FallbackValue='No track'}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               FontAttributes="Bold"
                               FontSize="12"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                        <Label Text="{Binding CurrentTrack.Artist, FallbackValue='Unknown'}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               FontSize="10"
                               LineBreakMode="TailTruncation"
                               MaxLines="1" />
                    </VerticalStackLayout>

                    <!-- Play / Pause Button Positioned at Far Right End -->
                    <Button Grid.Column="2"
                            Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIconConverter}}"
                            FontFamily="MaterialIcons"
                            FontSize="20"
                            Clicked="OnPlayPauseClicked"
                            BackgroundColor="#ea580c"
                            TextColor="White"
                            WidthRequest="38"
                            HeightRequest="38"
                            CornerRadius="19"
                            Padding="0"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Row 1: Seek Bar BELOW the Playback Buttons (Headless Expanding Seekbar + Timestamps) -->
                <Grid ColumnDefinitions="Auto, *, Auto"
                      ColumnSpacing="8"
                      VerticalOptions="Center"
                      Margin="0,2,0,0">
                    <!-- Current Position Timestamp -->
                    <Label Grid.Column="0"
                           Text="{Binding Position, StringFormat='{0:mm\\:ss}'}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="10"
                           VerticalOptions="Center" />

                    <!-- Headless Expanding Seek Bar (tactile height expansion on tap/drag) -->
                    <Border Grid.Column="1"
                            x:Name="AndroidMiniSeekTrack"
                            HeightRequest="4"
                            BackgroundColor="{AppThemeBinding Light=#cbd5e1, Dark=#2e2e36}"
                            StrokeThickness="0"
                            Padding="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="2" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAndroidMiniSeekTapped" />
                            <PanGestureRecognizer PanUpdated="OnAndroidMiniSeekPanUpdated" />
                        </Border.GestureRecognizers>
                        <Grid HorizontalOptions="Fill">
                            <BoxView x:Name="AndroidMiniSeekFill"
                                     Color="#ea580c"
                                     HorizontalOptions="Start"
                                     WidthRequest="0" />
                        </Grid>
                    </Border>

                    <!-- Duration Timestamp -->
                    <Label Grid.Column="2"
                           Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                           FontSize="10"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
